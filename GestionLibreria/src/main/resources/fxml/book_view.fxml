<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sergio.bookvault.fx.BookViewController"
            style="-fx-background-color: #f4f6f9;">

    <!-- ── CABECERA ──────────────────────────────────── -->
    <top>
        <VBox alignment="CENTER" spacing="4"
              style="-fx-background-color: #1a73e8; -fx-padding: 16;">
            <Label text="📚 BookVault" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;"/>
            <Label text="Gestiona tu colección de libros" style="-fx-text-fill: #cfd8dc; -fx-font-size: 13;"/>
        </VBox>
    </top>

    <!-- ── TABLA CENTRAL ─────────────────────────────── -->
    <center>
        <VBox spacing="10" style="-fx-padding: 12;">
            <!-- Barra de búsqueda -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Buscar por título..."
                           prefixColumnCount="25"/>
                <Button text="🔍 Buscar" onAction="#onSearch"
                        style="-fx-background-color: #1a73e8; -fx-text-fill: white; -fx-cursor: hand;"/>
                <Button text="↻ Mostrar todos" onAction="#onRefresh"
                        style="-fx-background-color: #607d8b; -fx-text-fill: white; -fx-cursor: hand;"/>
            </HBox>

            <TableView fx:id="bookTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white;">
                <columns>
                    <TableColumn fx:id="colTitle"  text="Título"  prefWidth="200"/>
                    <TableColumn fx:id="colAuthor" text="Autor"   prefWidth="150"/>
                    <TableColumn fx:id="colGenre"  text="Género"  prefWidth="110"/>
                    <TableColumn fx:id="colYear"   text="Año"     prefWidth="60"/>
                    <TableColumn fx:id="colIsbn"   text="ISBN"    prefWidth="120"/>
                    <TableColumn fx:id="colRating" text="Nota"    prefWidth="55"/>
                    <TableColumn fx:id="colRead"   text="Leído"   prefWidth="55"/>
                </columns>
            </TableView>

            <!-- Etiqueta de estado -->
            <Label fx:id="statusLabel" text="Listo." style="-fx-text-fill: #607d8b; -fx-font-size: 12;"/>
        </VBox>
    </center>

    <!-- ── FORMULARIO LATERAL ────────────────────────── -->
    <right>
        <VBox spacing="10" style="-fx-padding: 14; -fx-background-color: #ffffff;
              -fx-border-color: #ddd; -fx-border-width: 0 0 0 1;" prefWidth="280">

            <Label text="Datos del libro" style="-fx-font-size: 15; -fx-font-weight: bold;"/>
            <Separator/>

            <Label text="Título *"/>
            <TextField fx:id="titleField" promptText="Ej: Don Quijote"/>

            <Label text="Autor *"/>
            <TextField fx:id="authorField" promptText="Ej: Cervantes"/>

            <Label text="Género *"/>
            <ComboBox fx:id="genreCombo" promptText="Selecciona género" maxWidth="Infinity"/>

            <Label text="Año *"/>
            <TextField fx:id="yearField" promptText="Ej: 1605"/>

            <Label text="ISBN * (10 o 13 dígitos)"/>
            <TextField fx:id="isbnField" promptText="Ej: 9788420412146"/>

            <Label text="Puntuación (0-10)"/>
            <Slider fx:id="ratingSlider" min="0" max="10" value="5"
                    showTickLabels="true" showTickMarks="true"
                    majorTickUnit="2" minorTickCount="1"/>

            <CheckBox fx:id="readCheck" text="Ya lo he leído"/>

            <Separator/>

            <HBox spacing="8">
                <Button text="💾 Guardar" onAction="#onSave"
                        style="-fx-background-color: #43a047; -fx-text-fill: white; -fx-cursor: hand;"/>
                <Button text="✏️ Actualizar" onAction="#onUpdate"
                        style="-fx-background-color: #fb8c00; -fx-text-fill: white; -fx-cursor: hand;"/>
                <Button text="🗑 Eliminar" onAction="#onDelete"
                        style="-fx-background-color: #e53935; -fx-text-fill: white; -fx-cursor: hand;"/>
            </HBox>

            <Button text="🧹 Limpiar campos" onAction="#onClear" maxWidth="Infinity"
                    style="-fx-background-color: #90a4ae; -fx-text-fill: white; -fx-cursor: hand;"/>
        </VBox>
    </right>
</BorderPane>
